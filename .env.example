# Optional: enables OpenAI reasoning. Demo works without it using deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: only use with an explicitly authorised Deriv demo/test account.
DERIV_API_TOKEN=
DERIV_APP_ID=1089

# Optional: enables Slack signature verification.
SLACK_SIGNING_SECRET=

# Optional: sends a Telegram alert for ESCALATE/BLOCK verdicts. Both required to enable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Railway/VPS may provide PORT automatically. Local default is 8000.
PORT=8000
